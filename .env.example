# Configure server-side Environment Variables in Vercel Production.
# Generate the password verifier locally with npm run admin:vercel.
ARENA_ADMIN_EMAIL=
ARENA_ADMIN_CREDENTIAL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional canonical HTTPS origin when the default production domain is not used.
ARENA_PUBLIC_ORIGIN=
